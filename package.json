{
  "name": "tokenmeter",
  "productName": "Tokenmeter",
  "version": "1.0.3",
  "description": "Always-on desktop meter for Claude, Codex, Grok, Copilot and Gemini usage on Linux, Windows and macOS",
  "main": "src/main.js",
  "author": "Mugesh Kannan K S",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "icons": "electron scripts/render-icons.js",
    "social": "electron scripts/render-social.js"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.mugesh.tokenmeter",
    "productName": "Tokenmeter",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icons/linux",
      "synopsis": "AI token and quota usage on your desktop",
      "maintainer": "Mugesh Kannan K S"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${name}-${version}-setup-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "mugeshk97",
        "repo": "tokenmeter",
        "releaseType": "draft"
      }
    ]
  },
  "homepage": "https://github.com/mugeshk97",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
